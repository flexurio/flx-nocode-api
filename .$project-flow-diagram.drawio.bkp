        <mxCell id="features-box" value="KEY FEATURES:&#xa;• Multi-Database Support (MySQL, PostgreSQL, SQLite)&#xa;• JWT Authentication and Authorization&#xa;• Dynamic Schema-based CRUD Operations&#xa;• File Upload Support&#xa;• Data Encryption&#xa;• Real-time Logging&#xa;• Auto Table Generation&#xa;• Config-driven No-Code API&#xa;• CORS Support&#xa;• Static File Serving" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="2080" y="30" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="tech-stack" value="TECHNOLOGY STACK:&#xa;• Rust (Edition 2021)&#xa;• Actix-Web Framework&#xa;• SQLx (Database ORM)&#xa;• JWT (Authentication)&#xa;• AES-GCM (Encryption)&#xa;• Serde (Serialization)&#xa;• Tokio (Async Runtime)&#xa;• Multipart (File Upload)&#xa;• Base64 (Encoding)&#xa;• Regex (Pattern Matching)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="2080" y="250" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="request-flow" value="REQUEST FLOW:&#xa;1. Client sends HTTP request&#xa;2. CORS middleware processes&#xa;3. Authentication middleware validates&#xa;4. Route matching occurs&#xa;5. Schema validation performed&#xa;6. Database operation executed&#xa;7. Response formatted as JSON&#xa;8. Logging and monitoring&#xa;9. Response sent to client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="2080" y="470" width="300" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
