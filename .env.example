# Database Configuration
DB_TYPE=sqlite
SQLITE_URL=sqlite://data/flexurio.db
# MYSQL_URL=mysql://username:password@localhost:3306/database_name
# POSTGRES_URL=postgresql://username:password@localhost:5432/database_name
# MSSQL_URL=mssql://username:password@localhost:1433/database_name

# Security Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ENCRYPT_KEY=your-32-char-encryption-key-here

# Server Configuration
PORT=8080
ACTIX_WORKERS=1
DEBUG=false
LOGGING=true

# File Upload Configuration
UPLOAD_LIMIT_MB=10
LOC_STATIC=static
LOC_IMAGE=images
LOC_LOGGING=logs
LOC_CONFIG=config

# CORS Configuration
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080

# Write Queue / Redis (optional)
# Set WRITE_QUEUE_ENABLED=true to enqueue write operations to Redis.
WRITE_QUEUE_ENABLED=false
WRITE_QUEUE_FAST_ACK=true
WRITE_CONCURRENCY=4
# Backpressure limit for main queue length (0 = disabled)
WRITE_QUEUE_MAX_LEN=0
# Retry count for enqueue push to Redis
WRITE_QUEUE_ENQUEUE_RETRY=2
# Retry count for worker execute before moving to DLQ
WRITE_EXEC_RETRY_MAX=2

# IP Whitelist (comma-separated)
WHITE_LIST_IP=127.0.0.1,::1

# Base URL for file links
BASE_URL=http://localhost:8080

# Custom JWT Query (optional)
# CUSTOME_JWT_QUERY=SELECT custom_field FROM users WHERE id = {:?}

# ============================================================================
# PERFORMANCE TUNING & CONNECTION POOLING
# ============================================================================
# The following settings control database connection pool behavior and overall
# application performance. Optimize based on your deployment environment.

# CONNECTION POOL SIZING
# Default behavior: Automatically calculated from CPU cores
# - MIN_POOL:  Default = max(8, CPU_cores * 4) connections
# - MAX_POOL:  Default = clamp(CPU_cores * 8, 32-256) connections
# - IDLE_TIMEOUT: Default = 300 seconds (keep idle connections for reuse)
#
# For production deployments, uncomment and adjust based on workload:

# === LOW CONCURRENCY (dev/test, 1-2 vCPU) ===
# Optimal for: Development, testing, light production loads
# Expected throughput: 100-500 requests/sec
# MIN_POOL=4
# MAX_POOL=16
# IDLE_TIMEOUT=120

# === MEDIUM CONCURRENCY (4-8 vCPU, medium traffic) ===
# Optimal for: Standard production (5k-20k daily active users)
# Expected throughput: 500-2000 requests/sec
# MIN_POOL=16
# MAX_POOL=64
# IDLE_TIMEOUT=300

# === HIGH CONCURRENCY (16+ vCPU, high traffic) ===
# Optimal for: High-traffic production (50k+ daily active users)
# Expected throughput: 2000+ requests/sec
# MIN_POOL=32
# MAX_POOL=256
# IDLE_TIMEOUT=300

# PERFORMANCE MONITORING
# Enable access to /metrics endpoint for Prometheus-compatible metrics
# Metrics include: total_requests, request_errors, cache_hits, rate_limit_hits, db_pool_active
# No authentication required. Consider restricting via firewall in production.

# Rate Limit (optional overrides)
# Per-minute login attempt limit (per IP)
# RATE_LIMIT_LOGIN_PER_MIN=3
# Per-second limits for mutate and GET
# RATE_LIMIT_MUTATE_PER_SEC=10
# RATE_LIMIT_GET_PER_SEC=20
# 5-minute login failure thresholds (per-user and per-IP)
# RATE_LIMIT_LOGIN_FAIL_USER=5
# RATE_LIMIT_LOGIN_FAIL_IP=20

# ============================================================================
# PERFORMANCE TUNING METHODOLOGY
# ============================================================================
# 1. Baseline: Monitor /metrics endpoint (total_requests, errors, db_pool_active)
# 2. Adjust MIN_POOL: Start at 4x CPU cores, increase if db_pool_active stays maxed
# 3. Adjust MAX_POOL: Set to 8x CPU cores, increase to 256 for sustained high load
# 4. Monitor connection wait times: High idle times suggest pool too large
# 5. Monitor errors: Connection timeouts suggest pool too small
# 6. Response Compression: Enabled by default (gzip, deflate, brotli)
#    - Reduces bandwidth 60-70% for JSON responses
#    - CPU cost <5% (handled by compression middleware)
# ============================================================================
