# Database Configuration
DB_TYPE=sqlite
SQLITE_URL=sqlite://data/flexurio.db
# MYSQL_URL=mysql://username:password@localhost:3306/database_name
# POSTGRES_URL=postgresql://username:password@localhost:5432/database_name
# MSSQL_URL=mssql://username:password@localhost:1433/database_name

# Security Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ENCRYPT_KEY=your-32-char-encryption-key-here

# Server Configuration
PORT=8080
ACTIX_WORKERS=1
DEBUG=false
LOGGING=true

# File Upload Configuration
UPLOAD_LIMIT_MB=10
LOC_STATIC=static
LOC_IMAGE=images
LOC_LOGGING=logs
LOC_CONFIG=config

# CORS Configuration
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080

# IP Whitelist (comma-separated)
WHITE_LIST_IP=127.0.0.1,::1

# Base URL for file links
BASE_URL=http://localhost:8080

# Custom JWT Query (optional)
# CUSTOME_JWT_QUERY=SELECT custom_field FROM users WHERE id = {:?}

# Rate Limit (optional overrides)
# Per-minute login attempt limit (per IP)
# RATE_LIMIT_LOGIN_PER_MIN=3
# Per-second limits for mutate and GET
# RATE_LIMIT_MUTATE_PER_SEC=10
# RATE_LIMIT_GET_PER_SEC=20
# 5-minute login failure thresholds (per-user and per-IP)
# RATE_LIMIT_LOGIN_FAIL_USER=5
# RATE_LIMIT_LOGIN_FAIL_IP=20
