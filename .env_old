# HTTP server tuning
# How long to keep idle connections open (keep-alive). Increase to reduce TCP churn under load balancers.
HTTP_KEEPALIVE_SECS=30
# Accept queue backlog size (pending TCP handshakes). Increase if you see SYN backlog drops.
HTTP_BACKLOG=4096
# Max new connections per second per worker. Prevents thundering herd connection resets.
HTTP_MAX_CONN_RATE=512



