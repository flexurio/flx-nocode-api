        "get":{
                "columns":["sales_id", "sales_items.id", "product_id", 
                        "qty", "sales_items.price",
                        "sub_total_amount", "sales_items.created_at", 
                        "products.name as product_name"],
                "parameters":[
                        "products.name.like",
                        "products.name.like|id.like",
                        "products.name.eq",
                        "sales_id.eq",
                        "id.eq",
                        "name.eq", 
                        "deleted_at.is"
                ],
                "join_tables":[
                        {
                                "table":"products",
                                "columns":["id", "name"],
                                "logical":"sales_items.product_id = products.id",
                                "type_join":"inner"
                        }
                ],
                "column_groups":[],
                "having": [],
                "order_by":["sales_items.product_id"]

        },
        "post":{
                "before":"",
                "columns":["sales_id", "product_id","qty", 
                "price={products[{request.product_id}].price}",
                "sub_total_amount={request.qty} * {products[{request.product_id}].price}"],
                "after":"SQL:UPDATE sales SET total_amount = ( SELECT sum(sub_total_amount) FROM sales_items WHERE sales_items.sales_id = {request.sales_id} AND sales_items.deleted_at IS NULL ) WHERE id = {request.sales_id}"
        },
        "put":{
