# Flexurio no-code API — generated by `flx-nocode-api init`
# Database: sqlite | mysql | postgres | mssql | mongodb
DB_TYPE=sqlite
SQLITE_URL=sqlite://data/flexurio.db
# MYSQL_URL=mysql://user:pass@localhost:3306/flexurio
# POSTGRES_URL=postgresql://user:pass@localhost:5432/flexurio
# MSSQL_URL=mssql://user:pass@localhost:1433/flexurio

# Security (CHANGE THESE)
SECRET_KEY=__SECRET_KEY__
ENCRYPT_KEY=__ENCRYPT_KEY__

PORT=8080
REQUIRE_AUTH=true
DEBUG=false
RUST_LOG=info

LOC_CONFIG=config
LOC_STATIC=static
LOC_SEED=seed
UPLOAD_LIMIT_MB=10
CORS_ALLOW_ORIGINS=http://localhost:3000

# Optional: Redis for the read cache, write queue and email queue
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# WRITE_QUEUE_ENABLED=false
# EMAIL_CONSUMER_ENABLED=false
